<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Greta's microphone button (DECISIONS Q61). The hardened runtime blocks audio capture
         without it. The only entitlement the app carries; the helper and Sparkle's parts have none. -->
    <key>com.apple.security.device.audio-input</key> <true/>
</dict>
</plist>
